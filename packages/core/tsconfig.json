{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "outDir": "./lib",
    "paths": {
      "@/*": [
        "./src/*"
      ],
    },
    "noImplicitAny": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "tsdown.config.ts"
  ],
  "exclude": [
    "node_modules",
    "lib"
  ]
}